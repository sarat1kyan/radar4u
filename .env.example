# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather
BOT_API=

RADAR_ENV=dev
RADAR_LOG_LEVEL=INFO
# Public HTTPS URL of the Mini App (the api service), e.g. https://radar.example.com/app
RADAR_WEBAPP_URL=

# Local dev defaults to SQLite; docker-compose overrides these.
# RADAR_DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar
# RADAR_REDIS_URL=redis://localhost:6379/0

# Set to true if this deployment earns money. Providers whose free tier is
# non-commercial (public Overpass, Transitous, Open-Meteo) are then skipped
# unless you point RADAR_*_URL at your own instance and set *_SELF_HOSTED=true.
RADAR_COMMERCIAL=false
# RADAR_OVERPASS_URLS=https://overpass.example.com/api/interpreter
# RADAR_OVERPASS_SELF_HOSTED=false
# RADAR_TRANSITOUS_URL=https://motis.example.com
# RADAR_TRANSITOUS_SELF_HOSTED=false

# Optional commercial providers (see docs/PROVIDERS.md for onboarding)
DUFFEL_ACCESS_TOKEN=
TRAVELPAYOUTS_TOKEN=
LITEAPI_KEY=
TICKETMASTER_API_KEY=
# JSON list of partner listing feeds, see src/radar/providers/feeds.py
RADAR_LISTING_FEEDS=

# Language understanding: rules (default, offline) | anthropic | openai
RADAR_NLU_BACKEND=rules
RADAR_ANTHROPIC_API_KEY=
RADAR_ANTHROPIC_MODEL=
RADAR_OPENAI_API_KEY=
RADAR_OPENAI_BASE_URL=https://api.openai.com/v1
RADAR_OPENAI_MODEL=

# Demo data for domains without a live provider. Ignored when RADAR_ENV=prod.
RADAR_ENABLE_FIXTURES=false

# Radar engine
RADAR_MAX_RADARS_PER_USER=10
RADAR_MIN_RADAR_INTERVAL=1800
